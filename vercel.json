{
  "rewrites": [
    { "source": "/api/adsb/:path*", "destination": "https://api.adsb.lol/v2/:path*" },
    { "source": "/api/apl/:path*", "destination": "https://api.airplanes.live/v2/:path*" },
    { "source": "/api/adsbfi/:path*", "destination": "https://opendata.adsb.fi/api/v2/:path*" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
